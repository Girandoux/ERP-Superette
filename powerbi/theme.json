{
  "name": "Gestion Superette - Theme Professionnel",
  "dataColors": [
    "#0F766E",
    "#155E75",
    "#2563EB",
    "#15803D",
    "#CA8A04",
    "#B91C1C",
    "#7C3AED",
    "#0891B2"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#0F766E",
  "good": "#15803D",
  "neutral": "#CA8A04",
  "bad": "#B91C1C",
  "maximum": "#0F766E",
  "center": "#CA8A04",
  "minimum": "#B91C1C",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#64748B" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backgroundColor": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI",
            "fontSize": 12
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#475569" } },
            "titleColor": { "solid": { "color": "#0F172A" } },
            "gridlineColor": { "solid": { "color": "#E2E8F0" } }
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#475569" } },
            "titleColor": { "solid": { "color": "#0F172A" } },
            "gridlineColor": { "solid": { "color": "#E2E8F0" } }
          }
        ],
        "legend": [
          {
            "labelColor": { "solid": { "color": "#334155" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F766E" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 26
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#64748B" } },
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "cardTitle": [
          {
            "color": { "solid": { "color": "#64748B" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "dataLabels": [
          {
            "color": { "solid": { "color": "#0F766E" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 18
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#E2E8F0" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } },
            "rowPadding": 6,
            "outlineColor": { "solid": { "color": "#E2E8F0" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F1F5F9" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColor": { "solid": { "color": "#1E293B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "header": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "background": { "solid": { "color": "#F1F5F9" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ]
      }
    }
  },
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#0F172A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#475569"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#0F766E"
    }
  }
}
